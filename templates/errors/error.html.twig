{% extends 'base.html.twig' %}

{% block title %}Error {{ status }}{% endblock %}

{% block content %}
    <section class="card error-page">
        <p class="error-page__code">{{ status }}</p>
        <h1>{{ status >= 500 ? 'Algo ha ido mal' : 'No se pudo completar la petición' }}</h1>
        <p>{{ message }}</p>
        <p><a class="btn" href="{{ url('/') }}">Volver al listado de reservas</a></p>
    </section>
{% endblock %}
