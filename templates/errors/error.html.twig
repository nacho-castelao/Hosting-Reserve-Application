{% extends 'base.html.twig' %}
{% import 'partials/_macros.html.twig' as ui %}

{% block title %}Error {{ status }}{% endblock %}

{% block content %}
    <section class="error-page">
        <span class="error-page__icon error-page__icon--danger">{{ ui.icon('alert') }}</span>
        <p class="error-page__code">Error {{ status }}</p>
        <h1>{{ status >= 500 ? 'Algo ha ido mal' : 'No se pudo completar la petición' }}</h1>
        <p class="muted">{{ message }}</p>
        <p><a class="btn btn--primary" href="{{ url('/') }}">{{ ui.icon('arrow-left') }} Volver al listado</a></p>
    </section>
{% endblock %}
