{% extends 'base.html.twig' %}
{% import 'partials/_macros.html.twig' as ui %}

{% block title %}Página no encontrada{% endblock %}

{% block content %}
    <section class="error-page">
        <span class="error-page__icon">{{ ui.icon('search') }}</span>
        <p class="error-page__code">Error 404</p>
        <h1>No encontramos lo que buscas</h1>
        <p class="muted">{{ message }}</p>
        <p><a class="btn btn--primary" href="{{ url('/') }}">{{ ui.icon('arrow-left') }} Volver al listado</a></p>
    </section>
{% endblock %}
