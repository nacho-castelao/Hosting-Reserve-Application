<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <meta name="base-url" content="{{ base_url }}">
    <title>{% block title %}Reservas{% endblock %} · Gestor de reservas</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
        <div class="container site-header__inner">
            <a class="site-header__brand" href="{{ url('/') }}">Gestor de reservas</a>
            <nav aria-label="Principal">
                <a href="{{ url('/') }}">Reservas</a>
            </nav>
        </div>
    </header>

    <main id="contenido" class="container">
        {# Zona de avisos accesible: el JS escribe aquí los mensajes de éxito y error. #}
        <div id="status" class="status" role="status" aria-live="polite"></div>

        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container">Prueba técnica · PHP nativo, Twig y JavaScript</div>
    </footer>

    {% block scripts %}{% endblock %}
</body>
</html>
