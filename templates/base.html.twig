{% import 'partials/_macros.html.twig' as ui %}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <meta name="base-url" content="{{ base_url }}">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Reservas{% endblock %} · Gestor de reservas</title>
    <link rel="icon" href="{{ asset('img/favicon.svg') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {# Script clásico y síncrono: aplica el tema guardado antes de pintar (sin parpadeo). #}
    <script src="{{ asset('js/theme.js') }}"></script>
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
        <div class="container site-header__inner">
            <a class="brand" href="{{ url('/') }}">
                <span class="brand__mark">{{ ui.icon('logo') }}</span>
                <span class="brand__text">
                    <span class="brand__name">Gestor de reservas</span>
                    <span class="brand__tagline">Alojamientos</span>
                </span>
            </a>
            <div class="site-header__actions">
                <button type="button" class="icon-btn" id="theme-toggle" aria-label="Cambiar a tema oscuro" hidden>
                    {{ ui.icon('moon', 'theme-icon theme-icon--moon') }}
                    {{ ui.icon('sun', 'theme-icon theme-icon--sun') }}
                </button>
            </div>
        </div>
    </header>

    <main id="contenido" class="container main">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <span>Gestor de reservas</span>
            <span class="muted">PHP nativo · Twig · JavaScript</span>
        </div>
    </footer>

    {# Avisos accesibles: el JS añade aquí notificaciones de éxito y error. #}
    <div id="status" class="toasts" role="status" aria-live="polite"></div>

    {# Diálogo de confirmación reutilizable (ui.js → confirmDialog). #}
    <dialog id="confirm-dialog" class="dialog" aria-labelledby="confirm-title" aria-describedby="confirm-message">
        <form method="dialog" class="dialog__body">
            <span class="dialog__icon" data-dialog-icon>{{ ui.icon('alert') }}</span>
            <div>
                <h2 id="confirm-title" class="dialog__title"></h2>
                <p id="confirm-message" class="dialog__message"></p>
            </div>
            <div class="dialog__actions">
                <button type="submit" value="cancel" class="btn btn--secondary">Volver</button>
                <button type="submit" value="confirm" class="btn" data-dialog-confirm>Confirmar</button>
            </div>
        </form>
    </dialog>

    {% block scripts %}{% endblock %}
</body>
</html>
