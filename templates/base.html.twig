{% import 'partials/_macros.html.twig' as ui %}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <meta name="base-url" content="{{ base_url }}">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Reservas{% endblock %} · Bookhaven</title>
    <link rel="icon" href="{{ asset('img/favicon.svg') }}" type="image/svg+xml">
    <meta name="icon-sprite" content="{{ asset('img/icons.svg') }}">
    {# Sin ?v=: la URL debe coincidir con la de @font-face en app.css para no descargarlas dos veces. #}
    <link rel="preload" href="{{ base_url }}/assets/fonts/inter-latin-wght.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ base_url }}/assets/fonts/fraunces-latin-wght.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {# Script clásico y síncrono: aplica el tema guardado antes de pintar (sin parpadeo). #}
    <script src="{{ asset('js/theme.js') }}"></script>
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
        <div class="container site-header__inner">
            {% set usuario = usuario_actual() %}
            <a class="brand" href="{{ url(usuario ? '/panel' : '/') }}">
                <span class="brand__mark">{{ ui.icon('logo') }}</span>
                <span class="brand__text">
                    <span class="brand__name">Bookhaven</span>
                    <span class="brand__tagline">{{ usuario ? 'Reservas · ' ~ usuario.rol_label : 'Reservas' }}</span>
                </span>
            </a>
            <div class="site-header__actions">
                {% if usuario %}
                    {% set seccion = block('nav') is defined ? block('nav')|trim : '' %}
                    <nav class="main-nav" aria-label="Panel">
                        <a href="{{ url('/panel') }}"{% if seccion == 'reservas' %} aria-current="page"{% endif %}>{{ ui.icon('layers') }}<span>Reservas</span></a>
                        <a href="{{ url('/panel/alojamientos') }}"{% if seccion == 'alojamientos' %} aria-current="page"{% endif %}>{{ ui.icon('home') }}<span>Alojamientos</span></a>
                        {% if usuario.rol == 'admin' %}
                            <a href="{{ url('/panel/usuarios') }}"{% if seccion == 'usuarios' %} aria-current="page"{% endif %}>{{ ui.icon('users') }}<span>Anfitriones</span></a>
                        {% endif %}
                    </nav>
                    <form method="post" action="{{ url('/logout') }}" class="logout-form">
                        <input type="hidden" name="_csrf" value="{{ csrf_token() }}">
                        <span class="user-chip" title="{{ usuario.email }}">{{ ui.icon('user') }}<span>{{ usuario.nombre }}</span></span>
                        <button type="submit" class="icon-btn" aria-label="Cerrar sesión" title="Cerrar sesión">{{ ui.icon('log-out') }}</button>
                    </form>
                {% else %}
                    <a class="btn btn--ghost btn--small" href="{{ url('/login') }}">{{ ui.icon('log-in') }}<span>Acceso anfitriones</span></a>
                {% endif %}
                <button type="button" class="icon-btn" id="theme-toggle" aria-label="Cambiar a tema oscuro" hidden>
                    {{ ui.icon('moon', 'theme-icon theme-icon--moon') }}
                    {{ ui.icon('sun', 'theme-icon theme-icon--sun') }}
                </button>
            </div>
        </div>
    </header>

    <main id="contenido" class="container main">
        {% block content %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <span>Bookhaven</span>
            <span class="muted">PHP nativo · Twig · JavaScript</span>
        </div>
    </footer>

    {# Avisos accesibles: el JS añade aquí notificaciones de éxito y error. #}
    <div id="status" class="toasts" role="status" aria-live="polite"></div>

    {# Diálogo de confirmación reutilizable (ui.js → confirmDialog). #}
    <dialog id="confirm-dialog" class="dialog" aria-labelledby="confirm-title" aria-describedby="confirm-message">
        <form method="dialog" class="dialog__body">
            <span class="dialog__icon" data-dialog-icon>{{ ui.icon('alert') }}</span>
            <div>
                <h2 id="confirm-title" class="dialog__title"></h2>
                <p id="confirm-message" class="dialog__message"></p>
            </div>
            <div class="dialog__actions">
                <button type="submit" value="cancel" class="btn btn--secondary">Volver</button>
                <button type="submit" value="confirm" class="btn btn--primary" data-dialog-confirm>Confirmar</button>
            </div>
        </form>
    </dialog>

    {% block scripts %}{% endblock %}
</body>
</html>
