{# Icono del sprite public/assets/img/icons.svg (mismo que usa ui.js). #}
{% macro icon(name, class) %}
    <svg class="icon{{ class is defined ? ' ' ~ class : '' }}" aria-hidden="true" focusable="false"><use href="{{ asset('img/icons.svg') }}#{{ name }}"></use></svg>
{%- endmacro %}

{# Etiqueta de estado: color, icono y texto (igual que badge en ui.js). #}
{% macro badge(estado) %}
    {%- set iconos = { pendiente: 'clock', confirmada: 'check', cancelada: 'x' } -%}
    <span class="badge badge--{{ estado }}">{{ _self.icon(iconos[estado] ?? 'clock') }}{{ estado|capitalize }}</span>
{%- endmacro %}

{# Importe con formato español: 1.234,50 € #}
{% macro money(importe) %}{{ importe|number_format(2, ',', '.') }} €{% endmacro %}

{# 'YYYY-MM-DD' → '12 oct 2026' (igual que formatDate en ui.js). #}
{% macro fecha(iso) -%}
    {%- set meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'] -%}
    {{ iso|date('j') }} {{ meses[iso|date('n') - 1] }} {{ iso|date('Y') }}
{%- endmacro %}

{# '12 oct – 15 oct 2026'; con años distintos, ambos completos (igual que formatRange en ui.js). #}
{% macro rango(entrada, salida) -%}
    {%- set meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'] -%}
    {%- if entrada|date('Y') == salida|date('Y') -%}
        {{ entrada|date('j') }} {{ meses[entrada|date('n') - 1] }} – {{ _self.fecha(salida) }}
    {%- else -%}
        {{ _self.fecha(entrada) }} – {{ _self.fecha(salida) }}
    {%- endif -%}
{%- endmacro %}

{# Noches de la estancia: la salida no cuenta como noche. #}
{% macro noches(entrada, salida) -%}
    {%- set n = date(salida).diff(date(entrada)).days -%}
    {{ n }} {{ n == 1 ? 'noche' : 'noches' }}
{%- endmacro %}

{# Iniciales del huésped sobre un color estable derivado del id (igual que avatar en ui.js). #}
{% macro avatar(nombre, id, size) %}
    <span class="avatar avatar--{{ id % 6 }}{{ size is defined ? ' avatar--' ~ size : '' }}" aria-hidden="true">
        {{- nombre|split(' ')|filter(p => p != '')|slice(0, 2)|map(p => p|first|upper)|join -}}
    </span>
{%- endmacro %}

{# Mensaje de error de un campo de formulario (el JS rellena el mismo elemento). #}
{% macro field_error(name, errors) %}
    <p class="field-error" id="error-{{ name }}" data-error-for="{{ name }}"{% if errors[name] is not defined %} hidden{% endif %}>
        {{- errors[name] ?? '' -}}
    </p>
{% endmacro %}
