{% import 'partials/_macros.html.twig' as ui %}
{# Misma estructura que construye reservas-list.js (renderEmpty). #}
<tr class="empty-row">
    <td colspan="6">
        <div class="empty-state">
            <span class="empty-state__icon">{{ ui.icon('inbox') }}</span>
            <p class="empty-state__title">No hay reservas que coincidan</p>
            <p class="muted">Prueba con otros filtros o crea una reserva nueva.</p>
            <a class="btn btn--secondary btn--small js-clear-filters" href="{{ url('/') }}">Limpiar filtros</a>
        </div>
    </td>
</tr>
