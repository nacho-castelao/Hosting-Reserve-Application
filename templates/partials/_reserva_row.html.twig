{% import 'partials/_macros.html.twig' as ui %}
{# Misma estructura que construye reservas-list.js (renderRow) al re-renderizar la tabla. #}
<tr data-id="{{ reserva.id }}">
    <td data-label="Huésped" class="cell-guest">
        {{ ui.avatar(reserva.nombre_huesped, reserva.id) }}
        <span class="cell-guest__text">
            <a class="row-link" href="{{ url('/panel/reservas/' ~ reserva.id) }}">{{ reserva.nombre_huesped }}</a>
            <span class="muted">{{ reserva.email_huesped }}</span>
        </span>
    </td>
    <td data-label="Alojamiento">{{ reserva.nombre_alojamiento }}</td>
    <td data-label="Estancia">
        <span class="stay">
            <span class="stay__dates">
                <time datetime="{{ reserva.fecha_entrada }}">{{ ui.fecha(reserva.fecha_entrada) }}</time>
                {{ ui.icon('arrow-right', 'stay__arrow') }}
                <time datetime="{{ reserva.fecha_salida }}">{{ ui.fecha(reserva.fecha_salida) }}</time>
            </span>
            <span class="muted">{{ ui.noches(reserva.fecha_entrada, reserva.fecha_salida) }}</span>
        </span>
    </td>
    <td data-label="Estado" data-cell="estado">{{ ui.badge(reserva.estado) }}</td>
    <td data-label="Importe" class="num">{{ ui.money(reserva.importe) }}</td>
    <td data-label="Acciones" class="actions">
        <span class="actions__group" data-cell="acciones">
            {# Ocultos sin JS: los cambios de estado necesitan la API (PATCH). #}
            {% if reserva.estado == 'pendiente' %}
                <button type="button" class="btn btn--success-soft btn--icon js-estado" data-id="{{ reserva.id }}" data-estado="confirmada" title="Confirmar" hidden>
                    {{ ui.icon('check') }}<span class="visually-hidden">Confirmar reserva #{{ reserva.id }}</span>
                </button>
            {% endif %}
            {% if reserva.estado != 'cancelada' %}
                <button type="button" class="btn btn--danger-soft btn--icon js-estado" data-id="{{ reserva.id }}" data-estado="cancelada" title="Cancelar" hidden>
                    {{ ui.icon('x') }}<span class="visually-hidden">Cancelar reserva #{{ reserva.id }}</span>
                </button>
            {% endif %}
        </span>
        <a class="icon-btn icon-btn--small" href="{{ url('/panel/reservas/' ~ reserva.id) }}" aria-label="Ver reserva #{{ reserva.id }}">{{ ui.icon('chevron-right') }}</a>
    </td>
</tr>
