{% extends 'base.html.twig' %}
{% import 'partials/_macros.html.twig' as ui %}

{% block title %}Listado de reservas{% endblock %}
{% block nav %}reservas{% endblock %}

{% block content %}
    {% set usuario = usuario_actual() %}
    <div class="page-header">
        <div>
            <p class="eyebrow">Panel</p>
            <div class="page-header__title">
                <h1>Reservas</h1>
                <p id="results-count" class="page-header__count" aria-live="polite">
                    {{ total }} {{ total == 1 ? 'reserva' : 'reservas' }}{% if total > reservas|length %} (mostrando {{ reservas|length }}){% endif %}
                </p>
            </div>
            <p class="page-header__lead">
                {% if usuario.rol == 'admin' %}
                    Todas las reservas de todos los anfitriones. Confirma las pendientes o cancélalas.
                {% else %}
                    Las reservas de tus alojamientos. Los huéspedes reservan desde la web pública y tú las confirmas o cancelas.
                {% endif %}
            </p>
        </div>
        <a class="btn btn--secondary" href="{{ url('/panel/alojamientos') }}">
            {{ ui.icon('home') }} Mis alojamientos
        </a>
    </div>

    <section class="stats" aria-label="Resumen" id="stats">
        <div class="stat">
            <span class="stat__icon stat__icon--neutral">{{ ui.icon('layers') }}</span>
            <div>
                <p class="stat__label">Total de reservas</p>
                <p class="stat__value" data-stat="total">{{ resumen.total }}</p>
            </div>
        </div>
        <div class="stat">
            <span class="stat__icon stat__icon--warning">{{ ui.icon('clock') }}</span>
            <div>
                <p class="stat__label">Pendientes</p>
                <p class="stat__value" data-stat="pendiente">{{ resumen.pendiente }}</p>
            </div>
        </div>
        <div class="stat">
            <span class="stat__icon stat__icon--success">{{ ui.icon('check-circle') }}</span>
            <div>
                <p class="stat__label">Confirmadas</p>
                <p class="stat__value" data-stat="confirmada">{{ resumen.confirmada }}</p>
            </div>
        </div>
        <div class="stat">
            <span class="stat__icon stat__icon--primary">{{ ui.icon('euro') }}</span>
            <div>
                <p class="stat__label">Facturación prevista</p>
                <p class="stat__value" data-stat="ingresos">{{ ui.money(resumen.ingresos) }}</p>
            </div>
        </div>
    </section>

    {% if filter_errors is not empty %}
        <div class="alert alert--error" role="alert">
            {{ ui.icon('alert', 'alert__icon') }}
            <div>
                <p><strong>Algunos filtros no son válidos y se han ignorado:</strong></p>
                <ul>
                    {% for campo, mensaje in filter_errors %}
                        <li><strong>{{ campo }}</strong>: {{ mensaje }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    {% endif %}

    <form id="filtros" class="card filters" method="get" action="{{ url('/panel') }}" novalidate>
        <div class="filters__fields">
            <div class="field filters__search">
                <label for="f-q">Huésped</label>
                <div class="input-icon">
                    {{ ui.icon('search') }}
                    <input id="f-q" type="search" name="q" value="{{ filtro.q }}" maxlength="100" placeholder="Buscar por nombre" autocomplete="off">
                </div>
            </div>
            <div class="field">
                <label for="f-desde">Desde</label>
                <input id="f-desde" type="date" name="desde" value="{{ filtro.desde }}" aria-describedby="filtros-hint">
            </div>
            <div class="field">
                <label for="f-hasta">Hasta</label>
                <input id="f-hasta" type="date" name="hasta" value="{{ filtro.hasta }}" aria-describedby="filtros-hint">
            </div>
        </div>

        <div class="filters__bar">
            {# Filter Chip del diseño: radios con aspecto de chip (selección única). #}
            <fieldset class="chips">
                <legend class="chips__legend">Estado</legend>
                <label class="chip">
                    <input type="radio" name="estado" value=""{% if filtro.estado is empty %} checked{% endif %}>
                    <span>{{ ui.icon('check', 'chip__check') }}Todos</span>
                </label>
                {% for estado in estados %}
                    <label class="chip">
                        <input type="radio" name="estado" value="{{ estado.value }}"{% if filtro.estado == estado.value %} checked{% endif %}>
                        <span>{{ ui.icon('check', 'chip__check') }}{{ estado.label }}</span>
                    </label>
                {% endfor %}
            </fieldset>
            <div class="filters__actions">
                {# Con JS los filtros se aplican al escribir; el botón queda para el modo sin JS. #}
                <button type="submit" class="btn btn--secondary" id="filtros-aplicar">Filtrar</button>
                <a class="btn btn--ghost" href="{{ url('/panel') }}" id="filtros-limpiar">{{ ui.icon('x') }} Limpiar filtros</a>
            </div>
        </div>
        <p class="hint" id="filtros-hint">Las fechas muestran las reservas cuya estancia se solapa con ese rango.</p>
    </form>

    <section aria-labelledby="listado-titulo">
        <h2 id="listado-titulo" class="visually-hidden">Listado de reservas</h2>
        <ul class="booking-grid" id="reservas-body" role="list">
            {% for reserva in reservas %}
                {% include 'partials/_reserva_card.html.twig' with { reserva: reserva } only %}
            {% else %}
                {% include 'partials/_empty_card.html.twig' only %}
            {% endfor %}
        </ul>
    </section>

{% endblock %}

{% block scripts %}
    <script type="module" src="{{ asset('js/reservas-list.js') }}"></script>
{% endblock %}
