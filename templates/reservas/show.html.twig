{% extends 'base.html.twig' %}
{% import 'partials/_macros.html.twig' as ui %}

{% block title %}Reserva #{{ reserva.id }}{% endblock %}
{% block nav %}reservas{% endblock %}

{% block content %}
    <nav class="breadcrumb" aria-label="Ruta">
        <a href="{{ url('/panel') }}" class="back-link">{{ ui.icon('chevron-left') }} Todas las reservas</a>
    </nav>

    <article id="reserva-detalle" class="detail-grid" data-id="{{ reserva.id }}">
        <section class="card summary" aria-labelledby="reserva-titulo">
            <header class="summary__head">
                <div>
                    <p class="eyebrow">Reserva #{{ reserva.id }}</p>
                    <h1 id="reserva-titulo" class="summary__title" tabindex="-1">{{ reserva.nombre_huesped }}</h1>
                </div>
                <span data-cell="estado">{{ ui.badge(reserva.estado) }}</span>
            </header>

            <dl class="summary__fields">
                <div>
                    <dt>Email del huésped</dt>
                    <dd><a href="mailto:{{ reserva.email_huesped }}">{{ reserva.email_huesped }}</a></dd>
                </div>
                <div>
                    <dt>Alojamiento</dt>
                    <dd>{{ reserva.nombre_alojamiento }}</dd>
                </div>
                <div>
                    <dt>Entrada</dt>
                    <dd><time datetime="{{ reserva.fecha_entrada }}">{{ ui.fecha(reserva.fecha_entrada) }}</time></dd>
                </div>
                <div>
                    <dt>Salida</dt>
                    <dd><time datetime="{{ reserva.fecha_salida }}">{{ ui.fecha(reserva.fecha_salida) }}</time></dd>
                </div>
                <div>
                    <dt>Noches</dt>
                    <dd>{{ date(reserva.fecha_salida).diff(date(reserva.fecha_entrada)).days }}</dd>
                </div>
                <div>
                    <dt>Creada</dt>
                    <dd>{{ ui.fecha(reserva.fecha_creacion) }}, {{ reserva.fecha_creacion|date('H:i') }}</dd>
                </div>
                <div class="full">
                    <dt>Notas</dt>
                    <dd class="pre-line{{ reserva.notas ? '' : ' muted' }}">{{ reserva.notas ?: 'Sin notas.' }}</dd>
                </div>
            </dl>

            <footer class="summary__foot">
                <div>
                    <p class="eyebrow">Total · {{ ui.noches(reserva.fecha_entrada, reserva.fecha_salida) }}</p>
                    <p class="summary__amount">{{ ui.money(reserva.importe) }}</p>
                </div>
                {# Ocultos sin JS: los cambios de estado necesitan la API (PATCH). Mismo marcado que estadoButtons(…, 'detail'). #}
                <div class="summary__actions" data-cell="acciones">
                    {% if reserva.estado != 'cancelada' %}
                        <button type="button" class="btn btn--secondary js-estado" data-id="{{ reserva.id }}" data-estado="cancelada" hidden>
                            <span>Cancelar reserva</span>
                        </button>
                    {% endif %}
                    {% if reserva.estado == 'pendiente' %}
                        <button type="button" class="btn btn--primary js-estado" data-id="{{ reserva.id }}" data-estado="confirmada" hidden>
                            {{ ui.icon('check') }}<span>Confirmar reserva</span>
                        </button>
                    {% endif %}
                    {% if reserva.estado == 'cancelada' %}
                        <p class="summary__note">Reserva cancelada · sin más acciones</p>
                    {% endif %}
                </div>
            </footer>
        </section>

        <section class="card" aria-labelledby="historial-titulo">
            <h2 id="historial-titulo" class="card__title">Historial</h2>
            {# Misma estructura que construye reserva-detail.js (renderTimeline). #}
            {% set iconos = { creacion: 'plus', confirmada: 'check', cancelada: 'x' } %}
            <ol class="timeline" id="timeline">
                {% for evento in reserva.eventos %}
                    {% set tono = evento.descripcion ends with 'confirmada.' ? 'confirmada'
                        : (evento.descripcion ends with 'cancelada.' ? 'cancelada' : 'creacion') %}
                    <li class="timeline__item timeline__item--{{ tono }}">
                        <span class="timeline__dot">{{ ui.icon(iconos[tono]) }}</span>
                        <div>
                            <p class="timeline__text">{{ evento.descripcion }}</p>
                            <time datetime="{{ evento.fecha_creacion|date('Y-m-d\\TH:i:s') }}">{{ ui.fecha(evento.fecha_creacion) }} · {{ evento.fecha_creacion|date('H:i') }}</time>
                            <span class="timeline__actor">{{ evento.usuario ?? 'Huésped (web pública)' }}</span>
                        </div>
                    </li>
                {% else %}
                    <li class="timeline__item timeline__item--empty muted">Sin eventos registrados.</li>
                {% endfor %}
            </ol>
        </section>
    </article>
{% endblock %}

{% block scripts %}
    <script type="module" src="{{ asset('js/reserva-detail.js') }}"></script>
{% endblock %}
