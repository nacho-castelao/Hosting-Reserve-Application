# Copia este fichero como .env y ajusta los valores. .env NUNCA se sube a Git.

# Entorno: production | local
APP_ENV=production
# true SOLO en local: muestra detalles de errores. En producción siempre false.
APP_DEBUG=false

# Ruta base pública de la aplicación (sin barra final). Vacío = autodetectar.
# Ejemplos: "" (php -S / dominio raíz), "/reservas" (subcarpeta)
BASE_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reservas
DB_USER=root
DB_PASS=
